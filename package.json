{
  "name": "@bitbaum/design-tokens",
  "version": "1.5.0",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "description": "Design SSOT for OrangeCat, Loki and Solon — tokens, self-hosted faces, the Tailwind preset that maps them, and next/font/local calls for every face the fleet's apps use.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bitbaum/design-tokens.git"
  },
  "files": [
    "tokens.css",
    "composition.css",
    "tailwind-preset.js",
    "next-fonts.mjs",
    "fonts",
    "og"
  ],
  "exports": {
    "./tokens.css": "./tokens.css",
    "./composition.css": "./composition.css",
    "./tailwind-preset": "./tailwind-preset.js",
    "./fonts/*": "./fonts/*",
    "./next-fonts": "./next-fonts.mjs",
    "./og": {
      "types": "./og/index.d.ts",
      "default": "./og/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "design-tokens-next-fonts": "./next-fonts.mjs"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.js",
    "verify": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fonts:fetch": "node scripts/fetch-fonts.mjs",
    "fonts:og": "node scripts/og-fetch-fonts.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "3.9.10",
    "typescript": "^6.0.3"
  }
}
