{
  // There is no TypeScript here, and there should not be — the package ships
  // CSS, fonts and one CommonJS preset. `checkJs` is still worth its keep: it
  // catches the mistakes that actually happen in a config object as it grows
  // (a typo'd property, a call to something undefined, a stray trailing comma
  // in the wrong place) before a consumer's build does.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "node16",
    "moduleResolution": "node16",
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["tailwind-preset.js", "test/**/*.js"],
  "exclude": ["node_modules", "fonts"]
}
